        </mxCell>
        <mxCell id="pc" value="&lt;b&gt;Laptop&lt;/b&gt;&lt;br&gt;Docker: PHP-Backend + PostgreSQL&lt;br&gt;Browser: Raumkarte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7B5A93;fontFamily=Arial;fontSize=12;" vertex="1" parent="1">
