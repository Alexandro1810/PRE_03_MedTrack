        <mxCell id="lt1" value="Kabel (Strom)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="428" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lt2" value="Bluetooth LE (Funk)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="448" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lt3" value="WLAN (Funk)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="468" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Verkabelung:&lt;/b&gt; An den Pins der ESP32 wird nichts angeschlossen – die Antenne für Bluetooth und WLAN ist im ESP32-Modul eingebaut. Jeder ESP32 braucht nur Strom über Micro-USB (USB-Netzteil, Powerbank oder Laptop). Zum Flashen wird er mit einem Micro-USB-Kabel &lt;i&gt;mit Datenleitung&lt;/i&gt; an den Laptop angesteckt.&lt;br&gt;&lt;b&gt;Datenweg:&lt;/b&gt; A, B und C messen die Signalstärke des Beacons und schicken sie alle 2 s per WLAN (HTTP-POST) an das Backend am Laptop.&lt;br&gt;&lt;b&gt;Beacon:&lt;/b&gt; läuft mit einer CR2032-Knopfzelle, sendet ca. alle 200 ms, keine Kabel.&lt;br&gt;&lt;b&gt;Aufstellung:&lt;/b&gt; A, B und C an bekannten Positionen (x/y in m) möglichst weit auseinander, ca. 1–2 m hoch, nicht direkt hinter Metall." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C9D;align=left;verticalAlign=top;spacing=8;fontFamily=Arial;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="890" height="100" as="geometry" />
        </mxCell>
        <mxCell id="uA" value="Micro-USB" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#333333;fontFamily=Arial;fontSize=12;fontSize=10;labelBackgroundColor=#F7F9FC;" edge="1" parent="1" source="A" target="pA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
