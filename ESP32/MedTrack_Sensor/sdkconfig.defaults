# Grundeinstellungen – werden nur übernommen, wenn noch keine sdkconfig existiert.
# WLAN-Zugangsdaten und Sensor-ID gehören NICHT hierher, sondern in
# "idf.py menuconfig" (landet in sdkconfig, die nicht ins Git kommt).

# Bluetooth: nur BLE, mit dem schlanken NimBLE-Stack statt Bluedroid
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Hinweis: Die NimBLE-Rollen (Central/Peripheral) NICHT abschalten –
# in ESP-IDF 6.1 schlägt dann das Linken fehl (ble_sm_alg_encrypt fehlt).

# WLAN + BLE + HTTP-Client brauchen mehr als 1 MB Programmspeicher
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
